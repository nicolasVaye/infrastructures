# Copy to .env and change the values before deploying.
# JWT_SECRET MUST be >= 32 characters and not a default/known value: the
# backend refuses to boot otherwise (opt-out for throw-away sandboxes:
# INSECURE_DEV=1 in the environment).
JWT_SECRET=generate-a-long-random-string-here
STORAGE_SECRET=generate-another-long-random-string

# Optional: shared NiceGUI storage for multi-replica frontend deployments.
# NICEGUI_REDIS_URL=redis://redis:6379
